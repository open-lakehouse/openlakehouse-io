{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/wiki/",
      "destination": "/wiki/Main_Page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wiki",
      "destination": "https://wiki-origin.systemsnull.net/wiki/"
    },
    {
      "source": "/wiki/:path*",
      "destination": "https://wiki-origin.systemsnull.net/wiki/:path*"
    },
    {
      "source": "/w/:path*",
      "destination": "https://wiki-origin.systemsnull.net/w/:path*"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/app-shell"
    }
  ]
}
