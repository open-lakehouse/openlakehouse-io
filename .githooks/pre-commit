#!/usr/bin/env sh
#
# Repo pre-commit hook.
#
# 1. Delegates to any globally-configured hooks (e.g. the Databricks gitleaks
#    secret scanner). A repo-local core.hooksPath overrides the global one, so
#    we re-invoke the global hook here to avoid disabling it for this repo.
# 2. Strips npm registry proxy URLs out of bun.lock and package-lock.json so
#    they never get committed.
# 3. Blocks commits that leave package-lock.json out of sync with package.json.
#
set -e

# --- 1) Run globally-configured hooks, if any -------------------------------
global_hooks="$(git config --global core.hooksPath 2>/dev/null || true)"
if [ -n "$global_hooks" ]; then
  case "$global_hooks" in
    "~"*) global_hooks="$HOME${global_hooks#\~}" ;;
  esac
  if [ -x "$global_hooks/pre-commit" ]; then
    "$global_hooks/pre-commit" "$@" || exit $?
  fi
fi

staged="$(git diff --cached --name-only)"

# --- 2) Strip proxy URLs from lockfiles when staged -------------------------
staged_lockfiles=""
for lockfile in bun.lock package-lock.json; do
  if printf '%s\n' "$staged" | grep -qx "$lockfile"; then
    staged_lockfiles="$staged_lockfiles $lockfile"
  fi
done
if [ -n "$staged_lockfiles" ]; then
  if command -v bun >/dev/null 2>&1; then
    bun run scripts/strip-bun-lock-proxy.ts
    # shellcheck disable=SC2086 # word-splitting the file list is intended
    git add $staged_lockfiles
  else
    echo "pre-commit: 'bun' not found; skipping lockfile proxy strip" >&2
  fi
fi

# --- 3) Keep package-lock.json in sync with package.json --------------------
if printf '%s\n' "$staged" | grep -qxE 'package\.json|package-lock\.json'; then
  if command -v npm >/dev/null 2>&1; then
    if ! npm ls --package-lock-only >/dev/null 2>&1; then
      echo "pre-commit: package-lock.json is out of sync with package.json." >&2
      echo "  Fix: npm install --package-lock-only --ignore-scripts && bun run strip-lock-proxy" >&2
      echo "  See .agents/skills/update-lockfiles/SKILL.md" >&2
      exit 1
    fi
  else
    echo "pre-commit: 'npm' not found; skipping package-lock.json sync check" >&2
  fi
fi
